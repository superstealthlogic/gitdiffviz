{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Visualization Diff",
  "version": "0.1.0",
  "identifier": "com.gitvisualizationdiff.app",
  "build": {
    "frontendDist": "../../../viewer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Git Visualization Diff",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [],
    "externalBin": ["binaries/git-visualization-diff"]
  }
}
