opam-version: "2.0"
synopsis: "Typed OCaml backend for git diff visualization scene generation"
maintainer: ["Jared Carlson <jared.carlson23@gmail.com>"]
authors: ["Jared Carlson"]
license: "MIT"
homepage: "https://github.com/superstealthlogic/gitdiffviz"
bug-reports: "https://github.com/superstealthlogic/gitdiffviz/issues"
depends: [
  "ocaml"
  "dune" {>= "3.16"}
  "yojson"
  "cmdliner" {>= "1.1.0"}
  "alcotest" {with-test}
  "tree-sitter"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
pin-depends: [
  [
    "tree-sitter.dev"
    "git+https://github.com/semgrep/ocaml-tree-sitter-core.git#c4baff8d83b2e1f83f247acb11d0c9dafa5e48f7"
